{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hoangbeard/awesome-security-armory/blob/main/data/schema/catalog.schema.json",
  "title": "Awesome Security Armory group file",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "slug", "items"],
  "properties": {
    "category": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "name", "description", "tags", "subcategory", "tier", "added", "notes"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "subcategory": {"type": "string"},
        "tier": {"enum": ["main", "watchlist"]},
        "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "removed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removed"],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "category", "removed", "last_score", "reason", "source"],
            "properties": {
              "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
              "category": {"type": "string"},
              "removed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "last_score": {"type": ["number", "null"]},
              "reason": {"type": "string", "minLength": 1},
              "source": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
